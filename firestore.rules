rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------
       ADMIN DATA — owner-only, PLUS now requires a genuine admins/{uid}
       link doc (see the admins/{adminUid} block below). That link can
       only ever be created after a real adminInvites/{code} redemption,
       so an account created by calling createUserWithEmailAndPassword
       directly (skipping the client-side invite check via devtools)
       gets a valid Firebase Auth user but zero Firestore access — same
       shape as the tenant portal's invites -> portalAccounts chain.

       MIGRATION NOTE: any admin account created BEFORE this change has
       no admins/{uid} doc and will be locked out the moment this rule
       goes live. Before deploying, create an admins/{uid} doc for every
       existing admin (Firebase console -> Firestore -> admins collection
       -> doc ID = their UID -> any body, e.g. {backfilled:true}), or
       generate+redeem a real invite retroactively per client.

       users/{uid}/{store}/{docId}: locations, units, tenants, payments,
       pendingPayments, utilityBills, messages, moveoutSettlements — only
       the signed-in admin who owns them can read/write their own subtree.
    --------------------------------------------------------------- */
    match /users/{adminUid}/{store}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == adminUid
        && exists(/databases/$(database)/documents/admins/$(adminUid));

      // TENANT PORTAL CARVE-OUTS — a signed-in tenant portal account
      // (a different uid than the admin) needs narrow, specific access
      // to a few of the admin's documents. Each carve-out re-derives the
      // tenant's own portalAccounts link doc to confirm they're actually
      // linked to *this* adminUid before allowing anything, AND that the
      // link hasn't been revoked (`active != false` — missing counts as
      // active, so pre-existing accounts from before this field existed
      // are unaffected; only an explicit `active: false` blocks).
      allow get: if request.auth != null && store == 'tenants'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId == docId
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false;

      allow get: if request.auth != null && store == 'units'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.unitId == docId
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false;

      // FIX (data-leak patch): every list rule below now also requires
      // resource.data.tenantId to equal the caller's OWN tenantId, read
      // straight from their portalAccounts link doc (not from anything
      // the client sends). Firestore enforces this by REJECTING any
      // query that doesn't carry a matching `.where('tenantId', '==',
      // ...)` filter — so a tenant can no longer drop the app's own
      // tenantId filter in devtools and pull every other tenant's
      // payments/bills/settlements/messages for this admin. Previously
      // these rules only confirmed "a genuine linked, active portal
      // account for this admin," with no per-document tenant check.
      allow list: if request.auth != null && store == 'payments'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.tenantId == get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId;

      // Tenant may edit an approved payment THEY submitted (source ==
      // 'portal', portalUid == their own uid) — e.g. wrong amount or
      // date. Restricted to exactly the fields portalSaveEditedPayment
      // writes; nothing else (tenantId, unitId, source, portalUid,
      // proof, id, etc.) can be touched even via a modified client.
      allow update: if request.auth != null && store == 'payments'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.source == 'portal'
        && resource.data.portalUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['amountPaid', 'tag', 'datePaid', 'method', 'coveredPeriod', 'status', 'dueDate', 'notes', 'updatedAt']);

      // Tenant may remove an approved payment THEY submitted — same
      // tombstone convention as pendingPayments below (deleted:true
      // instead of a hard delete, so the admin's next sync sees an
      // update to merge rather than a gap to fill and resurrect it).
      // Only the tombstone fields may change; the record's actual
      // content is frozen. Deleting it here also means the amount stops
      // counting toward "paid" wherever balances are computed, since
      // balances are always derived live from whatever payment records
      // still exist — so the tenant's total owed goes back up on its
      // own, with no separate "restore the balance" step needed.
      allow update: if request.auth != null && store == 'payments'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.source == 'portal'
        && resource.data.portalUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deleted', 'deletedAt', 'updatedAt']);

      // Utility bills — read-only for the tenant portal, same shape as the
      // `payments` list carve-out above. Tenants never write these; only
      // the admin enters electricity/water charges (covered by the owner
      // rule at the top of this match block). FIX: now also scoped to the
      // caller's own tenantId — see note above the `payments` list rule.
      allow list: if request.auth != null && store == 'utilityBills'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.tenantId == get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId;

      // Move-out settlement — read-only for the tenant portal, same shape
      // as the `utilityBills` list carve-out above. Tenants never write
      // this; only the admin creates/edits it via the settlement sheet
      // (covered by the owner rule at the top of this match block). FIX:
      // now also scoped to the caller's own tenantId — see note above the
      // `payments` list rule.
      allow list: if request.auth != null && store == 'moveoutSettlements'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.tenantId == get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId;

      // FIX: create now also requires tenantId on the new claim to match
      // the caller's own tenantId — previously only portalUid was
      // checked, so a tenant could submit a pendingPayments claim
      // attributed to a different tenantId under the same admin.
      allow create: if request.auth != null && store == 'pendingPayments'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && request.resource.data.portalUid == request.auth.uid
        && request.resource.data.tenantId == get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId;

      // FIX: list scoped to the caller's own portalUid — matching the
      // field the portal client actually queries by (.where('portalUid',
      // '==', portal.user.uid)). NOTE: this must match the query's filter
      // field exactly, or Firestore rejects the whole query outright as
      // permission-denied (not just the mismatched docs) — a tenantId
      // check here silently broke every tenant's pendingPayments load
      // and got misreported client-side as "portal access revoked."
      // portalUid is actually a tighter scope than tenantId anyway, since
      // it's unique to this exact signed-in account.
      allow list: if request.auth != null && store == 'pendingPayments'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.portalUid == request.auth.uid;

      // Tenant may delete their own claim, but only while it's still pending
      // or rejected. Once approved it's become a real payment record and is
      // no longer self-deletable from the portal — see portalDeletePaymentClaim.
      allow delete: if request.auth != null && store == 'pendingPayments'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.portalUid == request.auth.uid
        && resource.data.status != 'approved';

      // Tenant self-delete is a TOMBSTONE (deleted:true), not a hard delete —
      // see portalDeletePaymentClaim. A hard delete left the admin's own local
      // IndexedDB copy of the claim unaware it was gone, so the admin's next
      // sync pull/push would resurrect it. This carve-out lets a tenant flip
      // only the tombstone fields (`deleted`, `deletedAt`, `updatedAt`) on a
      // claim that's theirs and not already approved — never the amount,
      // status, proof, or anything else.
      allow update: if request.auth != null && store == 'pendingPayments'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.portalUid == request.auth.uid
        && resource.data.status != 'approved'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deleted', 'deletedAt', 'updatedAt']);

      // MESSAGES — admin<->tenant chat thread (see openMessageThreadSheet /
      // portalRenderMessages). Each doc has {tenantId, sender: 'admin'|
      // 'tenant', text, createdAt, readByAdmin, readByTenant}. FIX: list
      // now also scoped to the caller's own tenantId — previously this
      // only confirmed "a genuine linked, active portal account for this
      // admin," not the specific tenantId of each doc returned, so any
      // tenant could list every tenant's message thread with this admin.
      allow list: if request.auth != null && store == 'messages'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.tenantId == get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId;

      // A tenant may create a message, but only one attributed to
      // themselves: sender must be 'tenant', and tenantId must match the
      // tenant their portal account is actually linked to (so they can't
      // post into someone else's thread even if they guessed a docId/uid).
      allow create: if request.auth != null && store == 'messages'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId == request.resource.data.tenantId
        && request.resource.data.sender == 'tenant';

      // Read receipt only — a tenant may flip `readByTenant` on an existing
      // message in their own thread (marking the admin's messages as read
      // once they've opened the thread — see portalMarkAdminMessagesRead),
      // and nothing else: not the text, sender, or readByAdmin flag.
      allow update: if request.auth != null && store == 'messages'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId == resource.data.tenantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTenant']);

      // A tenant is allowed to update ONLY their own tenant doc, and ONLY
      // the fields the portal ever actually writes: `documents` (ID
      // photo uploads), `leaseSignature` (e-signing their lease contract,
      // written to Supabase Storage with only the {url, storagePath,
      // signedAt} reference saved here), or claiming `portalUid`/
      // `portalEmail` one time at signup (guarded so it can't be
      // reassigned later).
      allow update: if request.auth != null && store == 'tenants'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId == docId
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['documents', 'leaseSignature', 'portalUid', 'portalEmail', 'updatedAt']);

      // MAINTENANCE REQUESTS — tenant-submitted repair/issue tickets. Same
      // shape as the pendingPayments carve-outs above: list is scoped to
      // the caller's own tenantId (never a blanket "any doc for this
      // admin"), and create requires both portalUid and tenantId to match
      // the caller's own portal link — so a tenant can't submit a ticket,
      // or list tickets, attributed to a different tenantId under the
      // same admin.
      allow list: if request.auth != null && store == 'maintenanceRequests'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.tenantId == get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId;

      allow create: if request.auth != null && store == 'maintenanceRequests'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && request.resource.data.portalUid == request.auth.uid
        && request.resource.data.tenantId == get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.tenantId
        && request.resource.data.status == 'open';

      // FIX (2026-07-28): the client (portalSubmitMaintenanceRequest /
      // portalDeleteMaintenanceRequest in index.html) has always expected
      // to Edit or withdraw a tenant's own OPEN ticket via a follow-up
      // .set() on the same doc — but no tenant `update` rule existed here
      // at all, so both actions failed outright with permission-denied
      // (misreported client-side as "check your connection", since that
      // catch block's fallback text doesn't distinguish a rules rejection
      // from an actual network failure). Confirmed via a real Delete
      // attempt in the tenant portal. Two narrow update rules restore the
      // client's actual behavior without opening anything further:
      // status/adminNotes remain admin-only (owner rule at the top of
      // this match block still covers that) — a tenant can never touch
      // those fields, and once status leaves 'open' (admin has started
      // work), both rules below stop applying, exactly matching the
      // client's own `if (m.status !== 'open') return;` guards.

      // 1) Edit — title/category/urgency/description/photos, exactly what
      //    portalSubmitMaintenanceRequest's isEdit branch writes.
      allow update: if request.auth != null && store == 'maintenanceRequests'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.portalUid == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'category', 'urgency', 'description', 'photos', 'updatedAt']);

      // 2) Withdraw — same tombstone convention as pendingPayments/payments
      //    self-delete above (deleted:true instead of a hard delete, so the
      //    admin's own sync sees an update to merge rather than a gap to
      //    fill and resurrect it). Exactly what portalDeleteMaintenanceRequest
      //    writes.
      allow update: if request.auth != null && store == 'maintenanceRequests'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.adminUid == adminUid
        && get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.active != false
        && resource.data.portalUid == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deleted', 'deletedAt', 'updatedAt']);
    }

    /* ---------------------------------------------------------------
       invites/{code} — one-time invite codes, top-level collection.
       (unchanged from before — this is the TENANT portal invite system,
       separate from adminInvites/{code} below.)
       - create: only the admin who owns the tenant/unit named in the
         invite can create one (adminUid must match their own uid).
       - get: any signed-in user may look up a code to redeem it (this is
         what a brand-new signup account needs, before it's linked to
         anything). The code itself is the "secret" here, same as a
         password-reset link — knowing it is what grants the read.
       - update: only allowed to flip `used` from false -> true, and only
         by the account claiming it (usedByUid must be the caller) — this
         covers both real redemption AND the admin voiding a stale code
         on regenerate.
       - delete/full overwrite: never allowed directly.
    --------------------------------------------------------------- */
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.used == false;
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && (
             request.resource.data.usedByUid == request.auth.uid ||               // tenant redeeming it
             request.resource.data.adminUid == request.auth.uid                    // admin voiding it on regenerate
           );
      allow delete: if false;
    }

    /* ---------------------------------------------------------------
       portalAccounts/{tenantAuthUid} — the link doc a tenant portal
       account uses to find "which admin, which tenant, which unit" on
       every sign-in (see onPortalAuthChanged).
       - get: only the account itself can read its own link.
       - create: only once, by that same account, and only if the
         invite doc it's citing was JUST marked used by this same uid —
         i.e. this create can only ever follow a legitimate redemption,
         never be forged directly.
       - update: NEW — the owning admin (not the tenant) may flip ONLY
         the `active` field (plus `updatedAt`), and only false<->true.
         This is what makes revokePortalAccess() actually work: every
         carve-out above now checks `active != false`, so setting this
         to false immediately cuts off read/write access everywhere,
         even though the link doc itself is otherwise still immutable.
       - delete: never — revocation is a flag flip, not a deletion, so
         portalLoadData's exists()/get() calls keep working (and the
         tenant gets a clear "revoked" message instead of a dangling
         reference error).
    --------------------------------------------------------------- */
    match /portalAccounts/{tenantAuthUid} {
      allow get: if request.auth != null && request.auth.uid == tenantAuthUid;
      allow create: if request.auth != null && request.auth.uid == tenantAuthUid
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.used == true
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.usedByUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt']);
      allow delete: if false;
    }

    /* ---------------------------------------------------------------
       adminInvites/{code} — one-time codes gating ADMIN account signup
       (the "ag-signup-btn" form in index.html), mirroring invites/{code}
       above but for the landlord/business-owner side instead of tenants.

       - create: NEVER via the client — deliberately `if false`. This is
         the top of the whole trust chain (an admin invite is what lets
         someone become an admin at all), so it's issued out-of-band:
         create the doc by hand in the Firebase console (collection
         `adminInvites`, doc ID = the code you hand the client, e.g.
         "K7QM-2XPL", body `{ used: false }`) when onboarding a new
         client. Nothing signed-in should be able to mint its own code.
       - get: any signed-in user may look up a code to redeem it — same
         reasoning as invites/{code}: the code itself is the secret, and
         the freshly-created admin account needs to read it before it's
         linked to anything.
       - update: only allowed to flip `used` false -> true, and only by
         the account claiming it (usedByUid must be the caller) — same
         shape as invites/{code}'s redemption path, no separate "void on
         regenerate" case since there's no regenerate UI for these.
       - delete: never.
    --------------------------------------------------------------- */
    match /adminInvites/{code} {
      allow get: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedByUid == request.auth.uid;
      allow delete: if false;
    }

    /* ---------------------------------------------------------------
       admins/{adminUid} — the link doc that actually gates every
       users/{adminUid}/... read/write above (see the owner rule at the
       top of this file). Existing purely so account creation and data
       access are decoupled: Firestore rules can't stop someone from
       calling createUserWithEmailAndPassword directly (that's an Auth
       API call, not a Firestore write), but they CAN require this doc
       to exist before that new uid can touch any real data — and this
       doc can only be created after a genuine adminInvites/{code}
       redemption, closing the loophole the client-side-only invite
       check had.
       - get: only the account itself.
       - create: only once, by that same account, and only if the
         adminInvites doc it cites was JUST marked used by this same
         uid — exactly the invites -> portalAccounts pattern above,
         applied one level up.
       - update/delete: never — an admin account, once linked, stays
         linked; there's no "revoke your own business" flow here.
    --------------------------------------------------------------- */
    match /admins/{adminUid} {
      allow get: if request.auth != null && request.auth.uid == adminUid;
      allow create: if request.auth != null && request.auth.uid == adminUid
        && exists(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteCode)).data.used == true
        && get(/databases/$(database)/documents/adminInvites/$(request.resource.data.inviteCode)).data.usedByUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
